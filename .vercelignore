# Source render outputs at repo root — only public/renders/ is served by Next.js
# Leading slash anchors to root so public/renders/ is NOT matched.
/renders/

# Local-only operational data
data/
prospects/
quotes.json

# Local generation/automation scripts (not used at runtime)
scripts/

# Static HTML snapshot — not part of the Next app
catalog-page.html

# Environment files (Vercel manages env vars via dashboard)
.env*.local

# ── Ops/admin panel — needs persistent DB + IMAP, doesn't work on Vercel.
# Excluded so the marketing site builds cleanly; panel keeps running locally.
app/panel/
app/api/panel/
components/panel/
middleware.ts
lib/imap.ts
lib/sequencer.ts
lib/classifier.ts

# NOTE: lib/db.ts, lib/sender/, lib/drafter.ts, and lib/auth.ts ship to Vercel
# because the public Quote Cart submit endpoint reuses them. On Vercel,
# getDb() falls back to /tmp/printbox.db (ephemeral but fine for the
# fire-and-forget owner notification). Panel routes that need persistent
# storage are excluded above and only run locally.
