# Panel auth
PANEL_USER=admin
PANEL_PASS=change-me

# Send mode: "dryrun" (writes .eml to data/sent/) or "live" (real SMTP send)
SEND_MODE=dryrun

# Auto-reply to inbound replies via Gemini (true|false). Safety rails always apply.
AUTO_REPLY_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Mailbox — works with any provider that gives you IMAP + SMTP
# ─────────────────────────────────────────────────────────────
MAIL_USER=you@yourdomain.com
MAIL_PASSWORD=your-mailbox-password

# Provider presets (uncomment one set):

# Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true

# Gmail / Workspace (requires App Password from https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true

# Outlook / Microsoft 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_SECURE=true

# How the From header is displayed
SENDER_NAME=פרינטבוקס
SENDER_EMAIL=you@yourdomain.com
REPLY_TO=

# ─────────────────────────────────────────────────────────────
# Google Gemini (inbound classification + auto-drafted Hebrew reply)
# Get a key at https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Image model for the Instagram mockup engine (scripts/generate-mockups.ts + /api/panel/mockups/generate)
# Default if unset: gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Video model for Veo Instagram Reels generator (scripts/generate-videos.ts)
# Default if unset: veo-3.1-generate-preview (latest Veo 3.1)
# Other options: veo-3.0-generate-001 (Veo 3 GA), veo-3.0-fast-generate-001 (faster, cheaper),
#                veo-3.1-fast-generate-preview, veo-3.1-lite-generate-preview, veo-2.0-generate-001
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# ─────────────────────────────────────────────────────────────
# Quote Cart & Owner Approval workflow (lib/quotes.ts)
# ─────────────────────────────────────────────────────────────
# Where new-quote notifications and approve/reject links are sent
OWNER_EMAIL=owner@yourdomain.com

# Optional Slack incoming-webhook URL. Leave blank to skip Slack channel.
SLACK_WEBHOOK_URL=

# 32+ char random string for signing approve/reject tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_TOKEN_SECRET=

# Public base URL used to build approve/reject links and panel deep-links
APP_BASE_URL=https://print-box.store
