# Panel auth
PANEL_USER=admin
PANEL_PASS=change-me

# Send mode: "dryrun" (writes .eml to data/sent/) or "live" (real SMTP send)
SEND_MODE=dryrun

# Auto-reply to inbound replies via Gemini (true|false). Safety rails always apply.
AUTO_REPLY_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Mailbox — works with any provider that gives you IMAP + SMTP
# ─────────────────────────────────────────────────────────────
MAIL_USER=you@yourdomain.com
MAIL_PASSWORD=your-mailbox-password

# Provider presets (uncomment one set):

# Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true

# Gmail / Workspace (requires App Password from https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true

# Outlook / Microsoft 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_SECURE=true

# How the From header is displayed
SENDER_NAME=פרינטבוקס
SENDER_EMAIL=you@yourdomain.com
REPLY_TO=

# ─────────────────────────────────────────────────────────────
# Google Gemini (inbound classification + auto-drafted Hebrew reply)
# Get a key at https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
